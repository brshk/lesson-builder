# Anthropic API — генерація матеріалів + веб-пошук
ANTHROPIC_API_KEY=sk-ant-...
# Необов'язково: модель (за замовчуванням claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Drive — програми навчання
# JSON ключа сервісного акаунта (одним рядком або в base64)
GOOGLE_SERVICE_ACCOUNT_KEY=
# ID папки з програмами навчання (з URL папки на Drive)
GOOGLE_DRIVE_FOLDER_ID=
